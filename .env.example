# Upstash Redis, for the footer's visitor counter.
# Copy this file to .env.local and paste the values from your Upstash
# database's "REST API" panel. .env.local is gitignored.
#
# Set the same two variables in Vercel:
#   Project -> Settings -> Environment Variables
#
# Leave them unset and the counter simply doesn't render.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
